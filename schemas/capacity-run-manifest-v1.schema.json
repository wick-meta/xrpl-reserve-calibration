{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xrpl-reserve-calibration:capacity-run-manifest-v1",
  "title": "Immutable non-counted pilot run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "manifest_scope", "counted_run", "pilot_complete", "study_id", "study_sha256",
    "source_commit", "run_id", "run_order_index", "base_reserve_xrp", "base_reserve_drops",
    "planned_account_count", "generated_account_count", "repetition", "network_id", "workload_name",
    "warmup_seconds", "measurement_seconds", "inputs", "candidate_runtime",
    "preregistered_protocol_reference", "protocol_alignment", "pilot_protocol", "metric_protocol", "metric_names",
    "acceptance_thresholds", "abort_rules", "environment", "created_at"
  ],
  "properties": {
    "schema_version": { "const": "capacity-run-manifest-v1" },
    "manifest_scope": { "const": "non-counted-pilot" },
    "counted_run": { "const": false },
    "pilot_complete": { "const": false },
    "study_id": { "const": "reserve-calibration-v1" },
    "study_sha256": { "$ref": "#/$defs/sha256" },
    "source_commit": { "type": "string", "pattern": "^[a-f0-9]{40}(?![\\s\\S])" },
    "run_id": { "type": "string", "pattern": "^r[0-9]{7}-a[0-9]{9}-n[0-9]{2}(?![\\s\\S])" },
    "run_order_index": { "type": "integer", "minimum": 1, "maximum": 72 },
    "base_reserve_xrp": { "enum": [1.0, 0.5, 0.25, 0.1] },
    "base_reserve_drops": { "enum": [1000000, 500000, 250000, 100000] },
    "planned_account_count": { "type": "integer", "enum": [10000, 25000, 50000, 100000, 250000, 500000] },
    "generated_account_count": { "type": "integer", "minimum": 1 },
    "repetition": { "type": "integer", "minimum": 1, "maximum": 3 },
    "network_id": { "const": 21338 },
    "workload_name": { "const": "accountroot-create-and-hold-v1" },
    "warmup_seconds": { "const": 300 },
    "measurement_seconds": { "const": 1800 },
    "inputs": {
      "type": "object", "additionalProperties": false,
      "required": ["config_sha256", "accounts_sha256", "workload_manifest_sha256"],
      "properties": {
        "config_sha256": { "$ref": "#/$defs/sha256" },
        "accounts_sha256": { "$ref": "#/$defs/sha256" },
        "workload_manifest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "candidate_runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["build_version", "image_digest", "network_id", "memory_limit_bytes", "allocated_logical_cpus"],
      "properties": {
        "build_version": { "const": "3.3.0" },
        "image_digest": { "const": "xrpllabsofficial/xrpld@sha256:353d5e016bb93519e9fcac715cdc8c2205b96c4cfe2d1f0f1d22a22f6efaff70" },
        "network_id": { "const": 21338 },
        "memory_limit_bytes": { "const": 17179869184 },
        "allocated_logical_cpus": { "const": 4 }
      }
    },
    "preregistered_protocol_reference": {
      "type": "object", "additionalProperties": false,
      "required": ["implementation_release", "implementation_commit"],
      "properties": {
        "implementation_release": { "const": "3.1.3" },
        "implementation_commit": { "const": "46b241ace8b30d9c9775d60ffba7d24b21903896" }
      }
    },
    "protocol_alignment": {
      "type": "object", "additionalProperties": false,
      "required": [
        "status", "method", "alignment_sha256", "implementation_equivalence_claimed",
        "cross_version_pooling_allowed", "cross_version_generalization_allowed",
        "counted_execution_authorized", "remaining_gates"
      ],
      "properties": {
        "status": { "const": "resolved-prospectively" },
        "method": { "const": "prospective-candidate-specific-amendment" },
        "alignment_sha256": { "const": "502959e92d30b587b638535b0955070446cd9235bfdd26d2310fe44c6f32574c" },
        "implementation_equivalence_claimed": { "const": false },
        "cross_version_pooling_allowed": { "const": false },
        "cross_version_generalization_allowed": { "const": false },
        "counted_execution_authorized": { "const": false },
        "remaining_gates": { "const": ["pilot-validation", "native-execution"] }
      }
    },
    "pilot_protocol": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "study_id", "status", "pilot_scope", "candidate_specific", "candidate_release",
        "workload_name", "representative_run_id", "pilot_accounts", "warmup_seconds", "measurement_seconds",
        "sample_cadence_seconds", "sample_cadence_basis", "post_warmup_sample_count", "measurement_sample_count", "total_sample_count",
        "ledger_advancements_per_measurement_step", "transaction_type", "scheduled_transactions_per_step",
        "scheduled_step_operation_order", "unscheduled_transactions_per_step", "unscheduled_step_operation",
        "sample_capture_stage", "validated_ledger_binding", "runtime_pacing",
        "transaction_schedule", "controlled_restart", "success_requirements", "native_execution_established",
        "counted_execution_authorized", "cross_version_pooling_allowed", "cross_version_generalization_allowed",
        "protocol_sha256", "execution_schema_sha256", "result_schema_sha256"
      ],
      "properties": {
        "schema_version": { "const": "capacity-pilot-protocol-v1" },
        "study_id": { "const": "reserve-calibration-v1" },
        "status": { "const": "frozen-before-live-pilot" },
        "pilot_scope": { "const": "non-counted-pilot" },
        "candidate_specific": { "const": true },
        "candidate_release": { "const": "3.3.0" },
        "workload_name": { "const": "accountroot-create-and-hold-v1" },
        "representative_run_id": { "const": "r0500000-a000010000-n01" },
        "pilot_accounts": { "const": 3 },
        "warmup_seconds": { "const": 300 },
        "measurement_seconds": { "const": 1800 },
        "sample_cadence_seconds": { "const": 2 },
        "sample_cadence_basis": { "const": "between-ledger-advancements" },
        "post_warmup_sample_count": { "const": 1 },
        "measurement_sample_count": { "const": 900 },
        "total_sample_count": { "const": 901 },
        "ledger_advancements_per_measurement_step": { "const": 1 },
        "transaction_type": { "const": "Payment" },
        "scheduled_transactions_per_step": { "const": 1 },
        "scheduled_step_operation_order": { "const": ["sign-one-payment", "submit-one-payment", "advance-one-standalone-ledger"] },
        "unscheduled_transactions_per_step": { "const": 0 },
        "unscheduled_step_operation": { "const": "advance-one-standalone-ledger-without-transaction" },
        "sample_capture_stage": { "const": "after-ledger-advancement" },
        "validated_ledger_binding": { "const": "exact-index-and-hash" },
        "runtime_pacing": {
          "const": {
            "target_cadence_seconds": 2.0,
            "target_mode": "absolute-monotonic",
            "maximum_target_lateness_seconds": 1.0,
            "observed_boundary": "ledger-advancement-completion",
            "consecutive_completion_interval_seconds": { "minimum": 1.0, "maximum": 3.0 },
            "scheduled_preparation_stage": "before-target"
          }
        },
        "transaction_schedule": {
          "const": [
            { "ordinal": 1, "measurement_sample_sequence": 1 },
            { "ordinal": 2, "measurement_sample_sequence": 450 },
            { "ordinal": 3, "measurement_sample_sequence": 900 }
          ]
        },
        "controlled_restart": {
          "const": { "starts_after_measurement_sample": 900, "recovery_seconds_max": 300, "poll_scope": "verified-candidate-only", "recovery_success_condition": "validated-ledger-tracking-resumed" }
        },
        "success_requirements": {
          "const": [
            "three-validated-successful-attempts", "exactly-901-schema-valid-ordered-samples",
            "schema-valid-metrics-summary", "no-abort-rule-breach", "all-predeclared-thresholds-passed",
            "controlled-restart-recovery-validated", "confirmed-reset", "exact-source-manifest-environment-bindings"
          ]
        },
        "native_execution_established": { "const": false },
        "counted_execution_authorized": { "const": false },
        "cross_version_pooling_allowed": { "const": false },
        "cross_version_generalization_allowed": { "const": false },
        "protocol_sha256": { "const": "259c453e1149444634782d078d583fc76e77af18dc276b9c80af9f3d7183ac2b" },
        "execution_schema_sha256": { "$ref": "#/$defs/sha256" },
        "result_schema_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "metric_protocol": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "document_sha256", "sample_schema_sha256", "summary_schema_sha256"],
      "properties": {
        "version": { "const": "capacity-metrics-protocol-v1" },
        "document_sha256": { "$ref": "#/$defs/sha256" },
        "sample_schema_sha256": { "$ref": "#/$defs/sha256" },
        "summary_schema_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "metric_names": {
      "const": ["ledger_bytes", "database_bytes", "resident_memory_bytes", "cpu_utilization_ratio", "ledger_close_seconds", "transaction_success_ratio", "recovery_seconds"]
    },
    "acceptance_thresholds": {
      "type": "object", "additionalProperties": false,
      "required": ["transaction_success_ratio_min", "ledger_close_seconds_p95_max", "recovery_seconds_max", "required_free_memory_ratio_min", "required_free_disk_ratio_min", "rationale"],
      "properties": {
        "transaction_success_ratio_min": { "const": 0.99 },
        "ledger_close_seconds_p95_max": { "const": 5.0 },
        "recovery_seconds_max": { "const": 300 },
        "required_free_memory_ratio_min": { "const": 0.10 },
        "required_free_disk_ratio_min": { "const": 0.10 },
        "rationale": { "const": "provisional safety bounds requiring public review before status can become preregistered-final" }
      }
    },
    "abort_rules": {
      "type": "object", "additionalProperties": false,
      "required": ["max_ledger_close_seconds", "max_resident_memory_bytes", "min_free_disk_bytes"],
      "properties": {
        "max_ledger_close_seconds": { "const": 30 },
        "max_resident_memory_bytes": { "const": 17179869184 },
        "min_free_disk_bytes": { "const": 10737418240 }
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["docker_server_version", "host_architecture", "host_operating_system", "host_logical_cpus", "host_memory_bytes", "candidate_image_digest", "candidate_image_architecture", "native_architecture_eligible"],
      "properties": {
        "docker_server_version": { "type": "string", "pattern": "^[0-9A-Za-z.+-]{1,64}(?![\\s\\S])" },
        "host_architecture": { "enum": ["amd64", "arm64"] },
        "host_operating_system": { "enum": ["linux", "docker-desktop"] },
        "host_logical_cpus": { "type": "integer", "minimum": 1 },
        "host_memory_bytes": { "type": "integer", "minimum": 1 },
        "candidate_image_digest": { "const": "xrpllabsofficial/xrpld@sha256:353d5e016bb93519e9fcac715cdc8c2205b96c4cfe2d1f0f1d22a22f6efaff70" },
        "candidate_image_architecture": { "enum": ["amd64", "arm64"] },
        "native_architecture_eligible": { "type": "boolean" }
      }
    },
    "created_at": { "type": "string", "format": "date-time", "pattern": "Z(?![\\s\\S])" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}(?![\\s\\S])" } }
}

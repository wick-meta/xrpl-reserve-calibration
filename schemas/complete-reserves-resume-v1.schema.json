{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xrpl-reserve-calibration:complete-reserves-resume-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "schedule_item_sha256", "result_artifact_sha256",
    "reset_confirmed", "recovery_confirmed"
  ],
  "properties": {
    "schema_version": {"const": "complete-reserves-resume-v1"},
    "run_id": {"type": "string", "pattern": "^cal-a[0-9]{9}-o[0-9]{9}-r[0-9]{2}$"},
    "schedule_item_sha256": {"$ref": "#/$defs/sha256"},
    "result_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "reset_confirmed": {"const": true},
    "recovery_confirmed": {"const": true}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

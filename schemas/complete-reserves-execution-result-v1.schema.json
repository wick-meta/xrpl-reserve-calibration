{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xrpl-reserve-calibration:complete-reserves-execution-result-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "status", "profile_id", "profile_sha256",
    "schedule_sha256", "schedule_item_sha256", "benchmark_sha256",
    "planning_security_sha256", "planning_bindings_sha256", "security_config_sha256",
    "distribution_sha256", "candidate_sha256", "snapshot_id", "ledger",
    "workload_artifact_sha256", "security_sha256", "recovery_seconds",
    "recovery_confirmed", "reset_confirmed", "network_scope", "counted_run",
    "execution_authorized"
  ],
  "properties": {
    "schema_version": {"const": "complete-reserves-execution-result-v1"},
    "run_id": {"type": "string", "pattern": "^cal-a[0-9]{9}-o[0-9]{9}-r[0-9]{2}$"},
    "status": {"const": "passed"},
    "profile_id": {"const": "complete-reserves-calibrated-v1"},
    "profile_sha256": {"$ref": "#/$defs/sha256"},
    "schedule_sha256": {"$ref": "#/$defs/sha256"},
    "schedule_item_sha256": {"$ref": "#/$defs/sha256"},
    "benchmark_sha256": {"$ref": "#/$defs/sha256"},
    "planning_security_sha256": {"$ref": "#/$defs/sha256"},
    "planning_bindings_sha256": {"$ref": "#/$defs/sha256"},
    "security_config_sha256": {"$ref": "#/$defs/sha256"},
    "distribution_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_sha256": {"$ref": "#/$defs/sha256"},
    "snapshot_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "ledger": {"type": "object"},
    "workload_artifact_sha256": {"$ref": "#/$defs/workloadHashes"},
    "security_sha256": {"$ref": "#/$defs/workloadHashes"},
    "recovery_seconds": {"type": "number", "minimum": 0},
    "recovery_confirmed": {"const": true},
    "reset_confirmed": {"const": true},
    "network_scope": {"const": "isolated-network-only"},
    "counted_run": {"const": false},
    "execution_authorized": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workloadHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "account-burst", "object-burst", "mixed", "churn", "recovery"],
      "properties": {
        "baseline": {"$ref": "#/$defs/sha256"},
        "account-burst": {"$ref": "#/$defs/sha256"},
        "object-burst": {"$ref": "#/$defs/sha256"},
        "mixed": {"$ref": "#/$defs/sha256"},
        "churn": {"$ref": "#/$defs/sha256"},
        "recovery": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

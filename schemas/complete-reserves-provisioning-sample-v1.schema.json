{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xrpl-reserve-calibration:complete-reserves-provisioning-sample-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "profile_id", "profile_sha256", "distribution_sha256",
    "candidate_sha256", "account_root_target", "owned_object_target",
    "measurement_source", "network_scope", "counted_run", "build_wall_seconds",
    "snapshot_wall_seconds", "clone_wall_seconds", "reset_wall_seconds",
    "recovery_wall_seconds", "cpu_seconds", "allocated_logical_cpus",
    "peak_memory_bytes", "state_disk_bytes", "io_read_bytes", "io_write_bytes",
    "attempted_transactions", "validated_transactions", "burned_fees_drops",
    "locked_xrp_drops", "released_xrp_drops", "ledger_growth_bytes",
    "database_growth_bytes", "ledger_close_seconds_p95", "finality_seconds_p95",
    "max_queue_depth", "reset_confirmed", "recovery_confirmed", "snapshot_sha256",
    "artifact_sha256"
  ],
  "properties": {
    "schema_version": {"const": "complete-reserves-provisioning-sample-v1"},
    "profile_id": {"const": "complete-reserves-calibrated-v1"},
    "profile_sha256": {"$ref": "#/$defs/sha256"},
    "distribution_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_sha256": {"$ref": "#/$defs/sha256"},
    "account_root_target": {"type": "integer", "minimum": 1},
    "owned_object_target": {"type": "integer", "minimum": 1},
    "measurement_source": {"const": "observed"},
    "network_scope": {"const": "isolated-network-only"},
    "counted_run": {"const": false},
    "build_wall_seconds": {"$ref": "#/$defs/positiveNumber"},
    "snapshot_wall_seconds": {"$ref": "#/$defs/positiveNumber"},
    "clone_wall_seconds": {"$ref": "#/$defs/positiveNumber"},
    "reset_wall_seconds": {"$ref": "#/$defs/positiveNumber"},
    "recovery_wall_seconds": {"$ref": "#/$defs/positiveNumber"},
    "cpu_seconds": {"$ref": "#/$defs/positiveNumber"},
    "allocated_logical_cpus": {"$ref": "#/$defs/positiveInteger"},
    "peak_memory_bytes": {"$ref": "#/$defs/positiveInteger"},
    "state_disk_bytes": {"$ref": "#/$defs/positiveInteger"},
    "io_read_bytes": {"$ref": "#/$defs/positiveInteger"},
    "io_write_bytes": {"$ref": "#/$defs/positiveInteger"},
    "attempted_transactions": {"$ref": "#/$defs/positiveInteger"},
    "validated_transactions": {"type": "integer", "minimum": 0},
    "burned_fees_drops": {"$ref": "#/$defs/positiveInteger"},
    "locked_xrp_drops": {"$ref": "#/$defs/positiveInteger"},
    "released_xrp_drops": {"type": "integer", "minimum": 0},
    "ledger_growth_bytes": {"$ref": "#/$defs/positiveInteger"},
    "database_growth_bytes": {"$ref": "#/$defs/positiveInteger"},
    "ledger_close_seconds_p95": {"$ref": "#/$defs/positiveNumber"},
    "finality_seconds_p95": {"$ref": "#/$defs/positiveNumber"},
    "max_queue_depth": {"type": "integer", "minimum": 0},
    "reset_confirmed": {"const": true},
    "recovery_confirmed": {"const": true},
    "snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "positiveInteger": {"type": "integer", "minimum": 1},
    "positiveNumber": {"type": "number", "exclusiveMinimum": 0}
  }
}

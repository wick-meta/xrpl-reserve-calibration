{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wick-meta/xrpl-reserve-calibration/blob/main/schemas/capacity-execution-v1.schema.json",
  "title": "Validated functional-smoke transaction execution record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "execution_scope", "counted_run", "pilot_complete", "status",
    "started_at", "finished_at", "teardown_status", "teardown_completed_at", "attempted_transactions", "validated_successes",
    "ledger_advancements", "outcomes"
  ],
  "properties": {
    "schema_version": { "const": "capacity-execution-v1" },
    "study_id": { "const": "reserve-calibration-v1" },
    "study_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "run_id": { "type": "string", "pattern": "^r[0-9]{7}-a[0-9]{9}-n[0-9]{2}$" },
    "config_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "workload_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accounts.jsonl", "manifest.json"],
      "properties": {
        "accounts.jsonl": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "manifest.json": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "execution_scope": { "const": "functional-smoke" },
    "counted_run": { "const": false },
    "pilot_complete": { "const": false },
    "status": { "enum": ["passed", "failed", "aborted"] },
    "error_code": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "base_reserve_xrp": { "enum": [1.0, 0.5, 0.25, 0.1] },
    "base_reserve_drops": { "enum": [1000000, 500000, 250000, 100000] },
    "account_count": { "type": "integer", "minimum": 1 },
    "repetition": { "type": "integer", "minimum": 1 },
    "started_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "finished_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "teardown_status": { "const": "passed" },
    "teardown_completed_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "attempted_transactions": { "type": "integer", "minimum": 0, "maximum": 1 },
    "validated_successes": { "type": "integer", "minimum": 0, "maximum": 1 },
    "ledger_advancements": { "type": "integer", "minimum": 0, "maximum": 1 },
    "preflight_validated_ledger_index": { "type": "integer", "minimum": 1 },
    "final_validated_ledger_index": { "type": "integer", "minimum": 1 },
    "final_validated_ledger_hash": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "outcomes": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal", "destination_account", "transaction_hash", "preliminary_engine_result",
          "final_transaction_result", "validated_ledger_index", "account_root_balance_drops"
        ],
        "properties": {
          "ordinal": { "const": 1 },
          "destination_account": { "type": "string", "pattern": "^r[1-9A-HJ-NP-Za-km-z]{24,34}$" },
          "transaction_hash": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
          "preliminary_engine_result": { "const": "tesSUCCESS" },
          "final_transaction_result": { "const": "tesSUCCESS" },
          "validated_ledger_index": { "type": "integer", "minimum": 1 },
          "account_root_balance_drops": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)$" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "passed" } }, "required": ["status"] },
      "then": {
        "required": [
          "study_id", "study_sha256", "run_id", "config_sha256", "workload_sha256",
          "base_reserve_xrp", "base_reserve_drops", "account_count", "repetition",
          "preflight_validated_ledger_index", "final_validated_ledger_index", "final_validated_ledger_hash"
        ],
        "properties": {
          "attempted_transactions": { "const": 1 },
          "validated_successes": { "const": 1 },
          "ledger_advancements": { "const": 1 },
          "outcomes": { "minItems": 1, "maxItems": 1 }
        },
        "not": { "required": ["error_code"] }
      },
      "else": {
        "required": ["error_code"],
        "properties": { "validated_successes": { "const": 0 } }
      }
    }
  ]
}

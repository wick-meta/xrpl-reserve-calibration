{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xrpl-reserve-calibration:account-delete-observation-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "workload_id", "network_scope", "counted_run",
    "execution_authorized", "account_delete_result", "account_deleted",
    "fee_drops", "fee_burned_drops", "reserve_increment_drops",
    "special_fee_minimum_drops", "base_reserve_drops",
    "base_reserve_before_drops", "base_reserve_after_drops",
    "owner_count_before", "owner_count_after",
    "owner_reserve_before_drops", "owner_reserve_after_drops",
    "deletion_blockers_before", "cleanup_finality", "sequence",
    "validated_ledger_index", "balance_before_drops",
    "balance_transferred_drops", "ledger_growth_bytes", "database_growth_bytes",
    "close_time_seconds", "finality_seconds", "reset_confirmed",
    "recovery_confirmed"
  ],
  "properties": {
    "schema_version": {"const": "account-delete-observation-v1"},
    "workload_id": {"const": "account-delete-lifecycle"},
    "network_scope": {"const": "isolated-network-only"},
    "counted_run": {"const": false},
    "execution_authorized": {"const": false},
    "account_delete_result": {"enum": ["tesSUCCESS", "tecHAS_OBLIGATIONS", "tefTOO_BIG", "tecTOO_SOON", "tecNO_DST", "tecDST_TAG_NEEDED", "tecNO_PERMISSION"]},
    "account_deleted": {"type": "boolean"},
    "fee_drops": {"type": "integer", "minimum": 0},
    "fee_burned_drops": {"type": "integer", "minimum": 0},
    "reserve_increment_drops": {"type": "integer", "minimum": 0},
    "special_fee_minimum_drops": {"type": "integer", "minimum": 0},
    "base_reserve_drops": {"type": "integer", "minimum": 0},
    "base_reserve_before_drops": {"type": "integer", "minimum": 0},
    "base_reserve_after_drops": {"type": "integer", "minimum": 0},
    "owner_count_before": {"type": "integer", "minimum": 0, "maximum": 1000},
    "owner_count_after": {"type": "integer", "minimum": 0, "maximum": 1000},
    "owner_reserve_before_drops": {"type": "integer", "minimum": 0},
    "owner_reserve_after_drops": {"type": "integer", "minimum": 0},
    "deletion_blockers_before": {"type": "array", "items": {"type": "string"}},
    "cleanup_finality": {"type": "boolean"},
    "sequence": {"type": "integer", "minimum": 0},
    "validated_ledger_index": {"type": "integer", "minimum": 0},
    "balance_before_drops": {"type": "integer", "minimum": 0},
    "balance_transferred_drops": {"type": "integer", "minimum": 0},
    "ledger_growth_bytes": {"type": "number"},
    "database_growth_bytes": {"type": "number"},
    "close_time_seconds": {"type": "number", "minimum": 0},
    "finality_seconds": {"type": "number", "minimum": 0},
    "reset_confirmed": {"type": "boolean"},
    "recovery_confirmed": {"type": "boolean"}
  }
}

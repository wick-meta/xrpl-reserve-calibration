{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xrpl-reserve-calibration:complete-reserves-calibration-item-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "repetition", "workload_class", "profile_id",
    "profile_sha256", "schedule_sha256", "schedule_item_sha256", "benchmark_sha256",
    "planning_security_sha256", "planning_bindings_sha256", "security_config_sha256",
    "distribution_sha256", "candidate_sha256", "network_scope", "account_root_target",
    "owned_object_target", "base_reserve_drops", "owner_reserve_drops",
    "fee_headroom_drops_per_step", "warmup_seconds", "measurement_seconds",
    "execution_limits", "status", "counted_run", "execution_authorized",
    "snapshot_id", "study_sha256", "config_sha256", "source_sha256",
    "ledger_index", "ledger_hash"
  ],
  "properties": {
    "schema_version": {"const": "complete-reserves-calibration-item-v1"},
    "run_id": {"type": "string", "pattern": "^cal-a[0-9]{9}-o[0-9]{9}-r[0-9]{2}$"},
    "repetition": {"type": "integer", "minimum": 1, "maximum": 3},
    "workload_class": {"const": "complete-reserves-security-suite-v1"},
    "profile_id": {"const": "complete-reserves-calibrated-v1"},
    "profile_sha256": {"$ref": "#/$defs/sha256"},
    "schedule_sha256": {"$ref": "#/$defs/sha256"},
    "schedule_item_sha256": {"$ref": "#/$defs/sha256"},
    "benchmark_sha256": {"$ref": "#/$defs/sha256"},
    "planning_security_sha256": {"$ref": "#/$defs/sha256"},
    "planning_bindings_sha256": {"$ref": "#/$defs/sha256"},
    "security_config_sha256": {"$ref": "#/$defs/sha256"},
    "distribution_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_sha256": {"$ref": "#/$defs/sha256"},
    "network_scope": {"const": "isolated-network-only"},
    "account_root_target": {"type": "integer", "minimum": 1},
    "owned_object_target": {"type": "integer", "minimum": 1},
    "base_reserve_drops": {"type": "integer", "minimum": 1},
    "owner_reserve_drops": {"type": "integer", "minimum": 1},
    "fee_headroom_drops_per_step": {"type": "integer", "minimum": 1},
    "warmup_seconds": {"const": 300},
    "measurement_seconds": {"const": 1800},
    "execution_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_batch_size", "max_retries", "deadline_seconds"],
      "properties": {
        "max_batch_size": {"type": "integer", "minimum": 1},
        "max_retries": {"const": 0},
        "deadline_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "status": {"const": "pending"},
    "counted_run": {"const": false},
    "execution_authorized": {"const": false},
    "snapshot_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "study_sha256": {"$ref": "#/$defs/sha256"},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "ledger_index": {"type": "integer", "minimum": 1},
    "ledger_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

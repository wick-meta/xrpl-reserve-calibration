{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wick-meta/xrpl-reserve-calibration/blob/main/schemas/capacity-workload-v1.schema.json",
  "title": "Deterministic capacity workload manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "study_sha256",
    "run_id",
    "workload_name",
    "generation_scope",
    "counted_run",
    "base_reserve_xrp",
    "base_reserve_drops",
    "planned_account_count",
    "generated_account_count",
    "repetition",
    "network_id",
    "source_account",
    "destination_model",
    "private_keys_generated",
    "signing_state",
    "account_id_derivation",
    "accounts_path",
    "accounts_sha256"
  ],
  "properties": {
    "schema_version": { "const": "capacity-workload-v1" },
    "study_id": { "const": "reserve-calibration-v1" },
    "study_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "run_id": { "type": "string", "pattern": "^r[0-9]{7}-a[0-9]{9}-n[0-9]{2}$" },
    "workload_name": { "const": "accountroot-create-and-hold-v1" },
    "generation_scope": { "enum": ["pilot", "full-plan"] },
    "counted_run": { "const": false },
    "base_reserve_xrp": { "enum": [1.0, 0.5, 0.25, 0.1] },
    "base_reserve_drops": { "enum": [1000000, 500000, 250000, 100000] },
    "planned_account_count": { "type": "integer", "minimum": 1 },
    "generated_account_count": { "type": "integer", "minimum": 1 },
    "repetition": { "type": "integer", "minimum": 1 },
    "network_id": { "const": 21338 },
    "source_account": { "const": "rHb9CJAWyB4rj91VRWn96DkukG4bwdtyTh" },
    "destination_model": { "const": "keyless-synthetic-account-id-v1" },
    "private_keys_generated": { "const": false },
    "signing_state": { "const": "unsigned-intents" },
    "account_id_derivation": {
      "const": "sha256(input)[0,20], input=xrpl-reserve-calibration/keyless-account-id-v1\\0<study_id>\\0<random_seed>\\0<run_id>\\0<ordinal>; reserved retry=sha256(input||\\0retry\\0<N>)[0,20]; address=base58(version-byte-0||account-id||first-4(double-sha256(version-byte-0||account-id))), alphabet=rpshnaf39wBUDNEGHJKLM4PQRST7VWXYZ2bcdeCg65jkm8oFqi1tuvAxyz"
    },
    "accounts_path": {
      "const": "accounts.jsonl",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "accounts_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
